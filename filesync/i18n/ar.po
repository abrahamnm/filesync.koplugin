# Arabic translations for FileSync KOReader plugin
#
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ar\n"

msgid "FileSync"
msgstr "FileSync"

msgid "FileSync - Wireless File Manager"
msgstr "FileSync - مدير الملفات اللاسلكي"

msgid "Launches a local HTTP web server and displays a QR code. Scan with your phone to manage books and files on your device wirelessly through a clean web interface."
msgstr "يُشغّل خادم HTTP محلي ويعرض رمز QR. امسحه بهاتفك لإدارة الكتب والملفات على جهازك لاسلكيًا من خلال واجهة ويب بسيطة."

msgid "Toggle FileSync server"
msgstr "تبديل خادم FileSync"

msgid "Stop file server"
msgstr "إيقاف خادم الملفات"

msgid "File server"
msgstr "خادم الملفات"

msgid "Start file server"
msgstr "تشغيل خادم الملفات"

msgid "Server port"
msgstr "منفذ الخادم"

msgid "Safe mode"
msgstr "الوضع الآمن"

msgid "When enabled, the web interface only lists document and image formats KOReader can open, and hides sidecar metadata folders and hidden files.\n\nDisable it to browse every file on the device, including hidden files and folders."
msgstr "عند التفعيل، تعرض واجهة الويب فقط صيغ المستندات والصور التي يمكن لـ KOReader فتحها، وتخفي مجلدات البيانات الوصفية المرافقة والملفات المخفية.\n\nعطّله لتصفّح جميع الملفات على الجهاز، بما في ذلك الملفات والمجلدات المخفية."

msgid "Show QR code"
msgstr "عرض رمز QR"

msgid "Check for updates"
msgstr "التحقق من التحديثات"

msgid "About"
msgstr "حول"

msgid "FileSync v%1\n\nWireless file manager for KOReader.\n\nStart the server, scan the QR code with your phone, and manage your books from any browser on the same WiFi network.\n\nProject:\ngithub.com/abrahamnm/filesync.koplugin"
msgstr "FileSync v%1\n\nمدير ملفات لاسلكي لـ KOReader.\n\nشغّل الخادم، وامسح رمز QR بهاتفك، وأدِر كتبك من أي متصفح على نفس شبكة WiFi.\n\nالمشروع:\ngithub.com/abrahamnm/filesync.koplugin"

msgid "Cancel"
msgstr "إلغاء"

msgid "Save"
msgstr "حفظ"

msgid "Port set to %1. Restart the server for changes to take effect."
msgstr "تم تعيين المنفذ إلى %1. أعد تشغيل الخادم لتطبيق التغييرات."

msgid "Port set to %1. Ports below 1024 need root access (available on Kobo/Kindle); if unavailable the server falls back to port %2. Restart the server for changes to take effect."
msgstr "تم تعيين المنفذ إلى %1. المنافذ الأقل من 1024 تتطلب صلاحيات الجذر (متوفرة على Kobo/Kindle)؛ وإن لم تتوفر فسيعود الخادم إلى المنفذ %2. أعد تشغيل الخادم لتطبيق التغييرات."

msgid "Invalid port. Please enter a number between 1 and 65535."
msgstr "منفذ غير صالح. يرجى إدخال رقم بين 1 و65535."

msgid "Port %1 needs root access and isn't available on this device. Using port %2 instead."
msgstr "المنفذ %1 يتطلب صلاحيات الجذر وهو غير متاح على هذا الجهاز. سيتم استخدام المنفذ %2 بدلًا منه."

msgid "FileSync server is already running."
msgstr "خادم FileSync يعمل بالفعل."

msgid "Could not determine device IP address. Make sure WiFi is connected."
msgstr "تعذّر تحديد عنوان IP الخاص بالجهاز. تأكد من أن WiFi متصل."

msgid "Failed to start server: %1"
msgstr "فشل تشغيل الخادم: %1"

msgid "FileSync server stopped."
msgstr "تم إيقاف خادم FileSync."

msgid "Stopping server..."
msgstr "جارٍ إيقاف الخادم..."

msgid "Low Battery"
msgstr "بطارية منخفضة"

msgid "Battery level is at %1%. Running the server may drain the battery quickly."
msgstr "مستوى البطارية %1%. قد يؤدي تشغيل الخادم إلى استنزاف البطارية بسرعة."

msgid "Start Anyway"
msgstr "تشغيل على أي حال"

msgid "Server is not running."
msgstr "الخادم لا يعمل."

msgid "Scan the QR code or enter the URL\nin your browser.\n\nBoth devices must be on the same WiFi network."
msgstr "امسح رمز QR أو أدخل عنوان URL\nفي متصفحك.\n\nيجب أن يكون كلا الجهازين على نفس شبكة WiFi."

msgid "Use the arrow keys to select a button and press the centre key to activate it. Press Back to leave this screen."
msgstr "استخدم مفاتيح الأسهم لاختيار زر واضغط المفتاح الأوسط لتفعيله. اضغط رجوع لمغادرة هذه الشاشة."

msgid "Press Back to leave this screen."
msgstr "اضغط رجوع لمغادرة هذه الشاشة."

msgid "Stop Server"
msgstr "إيقاف الخادم"

msgid "File server is running"
msgstr "خادم الملفات يعمل"

msgid "The server will keep running in the background and prevent the device from sleeping. What would you like to do?"
msgstr "سيستمر الخادم في العمل في الخلفية وسيمنع الجهاز من الدخول في وضع السكون. ماذا تريد أن تفعل؟"

msgid "Stop server"
msgstr "إيقاف الخادم"

msgid "Keep running"
msgstr "إبقاؤه يعمل"

msgid "Image preview"
msgstr "معاينة الصورة"

# ==============================
# Plugin updater
# ==============================

msgid "Checking for updates..."
msgstr "جارٍ التحقق من التحديثات..."

msgid "FileSync is up to date (v%1)."
msgstr "FileSync محدّث (v%1)."

msgid "A new version of FileSync is available!\n\nCurrent: v%1\nNew: v%2"
msgstr "يتوفر إصدار جديد من FileSync!\n\nالحالي: v%1\nالجديد: v%2"

msgid "Update now"
msgstr "التحديث الآن"

msgid "Later"
msgstr "لاحقًا"

msgid "Downloading update..."
msgstr "جارٍ تنزيل التحديث..."

msgid "Installing update..."
msgstr "جارٍ تثبيت التحديث..."

msgid "FileSync has been updated successfully!\n\nPlease restart KOReader for the changes to take effect."
msgstr "تم تحديث FileSync بنجاح!\n\nيرجى إعادة تشغيل KOReader لتطبيق التغييرات."

msgid "FileSync has been updated successfully!\n\nPlease close and reopen KOReader for the changes to take effect."
msgstr "تم تحديث FileSync بنجاح!\n\nيرجى إغلاق KOReader وإعادة فتحه لتطبيق التغييرات."

msgid "Restart now"
msgstr "إعادة التشغيل الآن"

msgid "Could not check for updates.\n\n%1"
msgstr "تعذّر التحقق من التحديثات.\n\n%1"

msgid "Could not determine the latest version."
msgstr "تعذّر تحديد أحدث إصدار."

msgid "Could not find a download URL for this release."
msgstr "تعذّر العثور على رابط تنزيل لهذا الإصدار."

msgid "Failed to parse update information from GitHub."
msgstr "فشل تحليل معلومات التحديث من GitHub."

msgid "GitHub API returned status %1."
msgstr "أعادت واجهة GitHub البرمجية الحالة %1."

msgid "Network error: could not reach GitHub."
msgstr "خطأ في الشبكة: تعذّر الوصول إلى GitHub."

msgid "Download failed with status %1."
msgstr "فشل التنزيل بالحالة %1."

msgid "Download failed.\n\n%1"
msgstr "فشل التنزيل.\n\n%1"

msgid "Download failed: network error."
msgstr "فشل التنزيل: خطأ في الشبكة."

msgid "Cannot create temporary file: %1"
msgstr "تعذّر إنشاء ملف مؤقت: %1"

msgid "Cannot determine plugin parent directory."
msgstr "تعذّر تحديد المجلد الأصل للإضافة."

msgid "Failed to back up current plugin. Update aborted."
msgstr "فشل النسخ الاحتياطي للإضافة الحالية. تم إلغاء التحديث."

msgid "Failed to install update. Previous version has been restored."
msgstr "فشل تثبيت التحديث. تمت استعادة الإصدار السابق."

msgid "Update installation failed.\n\n%1"
msgstr "فشل تثبيت التحديث.\n\n%1"

msgid "Update verification failed: extracted files do not look like a valid plugin."
msgstr "فشل التحقق من التحديث: الملفات المستخرجة لا تبدو إضافة صالحة."

